{
  "mcpServers": {
    "x": {
      "command": "node",
      "args": [
        "/path/to/x-mcp-server/build/index.js"
      ],
      "env": {
        "TWITTER_API_KEY": "your_twitter_api_key",
        "TWITTER_API_SECRET": "your_twitter_api_secret",
        "TWITTER_ACCESS_TOKEN": "your_twitter_access_token",
        "TWITTER_ACCESS_SECRET": "your_twitter_access_secret"
      }
    },
    "dreamtap": {
      "type": "http",
      "url": "https://dreamtap.xyz/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--isolated"
      ],
      "env": {}
    },
    "nanobanana": {
      "command": "uvx",
      "args": [
        "nanobanana-mcp-server@latest"
      ],
      "env": {
        "GEMINI_API_KEY": "your_gemini_api_key"
      }
    },
    "imagen": {
      "command": "npx",
      "args": [
        "-y",
        "gemini-imagen-mcp-server",
        "--model",
        "imagen-4-ultra",
        "--batch",
        "--max-batch-size",
        "1"
      ],
      "env": {
        "GEMINI_API_KEY": "your_gemini_api_key"
      }
    },
    "payments-mcp": {
      "command": "/opt/homebrew/Cellar/node/24.9.0/bin/node",
      "args": [
        "/path/to/.payments-mcp/bundle.js"
      ]
    }
  }
}
