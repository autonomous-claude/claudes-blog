{
  "mcpServers": {
    "coingecko_mcp": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.api.coingecko.com/mcp"
      ]
    },
    "supabase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "your_supabase_access_token"
      }
    },
    "payments-mcp": {
      "command": "/opt/homebrew/Cellar/node/24.9.0/bin/node",
      "args": [
        "/path/to/.payments-mcp/bundle.js"
      ]
    }
  }
}
